# ══════════════════════════════════════════════════════════════════════════════
#  GenericAgent — Exemple de configuration d'environnement
#  Copiez ce fichier en .env et renseignez les valeurs
#    cp .env.example .env
# ══════════════════════════════════════════════════════════════════════════════

# ── Clé API du fournisseur LLM ──────────────────────────────────────────────
# Obligatoire pour utiliser l'agent.  Exemples :
#   - OpenAI    : sk-...
#   - Anthropic : sk-ant-...
LLM_API_KEY=

# ── URL de base du point de terminaison LLM ─────────────────────────────────
# Laisser vide pour utiliser l'URL par défaut du fournisseur.
# Utile pour les proxys ou les endpoints compatibles OpenAI.
LLM_BASE_URL=

# ── Nom du modèle LLM ──────────────────────────────────────────────────────
# Exemples : gpt-4o, claude-3-opus-20240229, deepseek-chat
LLM_MODEL=

# ── Répertoire de travail de l'agent ────────────────────────────────────────
# Répertoire utilisé pour les fichiers temporaires et les sorties.
# Par défaut : workspace
AGENT_WORKSPACE_DIR=workspace

# ── Niveau de journalisation ────────────────────────────────────────────────
# Valeurs possibles : DEBUG, INFO, WARNING, ERROR, CRITICAL
# Par défaut : INFO
LOG_LEVEL=INFO
